    border: 1px solid #2a2d3e;
    border-radius: 20px;
    padding: 4px 12px;
    font-size: 0.75rem;
    font-family: 'DM Mono', monospace;
    color: #9ca3af;
    margin: 3px;
}
.zone-pill.hot { border-color: #f59e0b; color: #f59e0b; }
.zone-pill.warm { border-color: #3b82f6; color: #60a5fa; }

.anomaly-card {
    background: #1c1014;
    border: 1px solid #4c1d1d;
    border-left: 3px solid #ef4444;
    border-radius: 8px;
    padding: 12px 16px;
    margin: 6px 0;
